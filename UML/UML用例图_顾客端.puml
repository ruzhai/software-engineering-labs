@startuml UML用例图_顾客端
skinparam dpi 250
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam ArrowFontColor #4A5568
skinparam ArrowFontSize 11
skinparam UsecaseBackgroundColor #F7FAFC
skinparam UsecaseBorderColor #4A5568
skinparam UsecaseFontColor #2D3748
skinparam UsecaseFontSize 12
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #4A5568
skinparam ActorFontColor #2D3748
skinparam ActorFontSize 13
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #A0AEC0
skinparam RectangleFontColor #2D3748
skinparam RectangleFontSize 13
skinparam nodesep 45
skinparam ranksep 55
left to right direction

actor "顾客" as C
actor "支付网关" as G <<外部系统>>

rectangle "酒店预订系统" {
  usecase "搜索房型" as UC1
  usecase "查看房型与实时库存" as UC2
  usecase "预订下单" as UC3
  usecase "校验库存与价格" as UC10
  usecase "支付订单" as UC4
  usecase "取消订单" as UC5
  usecase "提交取消申请" as UC6
  usecase "申请升级房型" as UC7
  usecase "提交评价" as UC8
  usecase "查看我的订单" as UC9
}

C --> UC1
C --> UC3
C --> UC4
C --> UC5
C --> UC7
C --> UC8
C --> UC9
G --> UC4

UC1 ..> UC2 : <<include>>
UC3 ..> UC10 : <<include>>
UC5 ..> UC6 : <<extend>>
UC7 ..> UC3 : <<extend>>
@enduml
