@startuml UML类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam ArrowFontColor #4A5568
skinparam ArrowFontSize 11
skinparam ClassBackgroundColor #F7FAFC
skinparam ClassBorderColor #4A5568
skinparam ClassFontColor #2D3748
skinparam ClassFontSize 13
skinparam ClassAttributeFontSize 11
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #A0AEC0
skinparam PackageFontColor #2D3748
skinparam PackageFontSize 13
skinparam nodesep 45
skinparam ranksep 60

class 用户 {
  - 用户ID : 字符串
  - 姓名 : 字符串
  - 手机号 : 字符串
  - 密码哈希 : 字符串
  - 角色 : 枚举
  - 状态 : 枚举
}
class 排班 {
  - 排班ID : 字符串
  - 日期 : 日期
  - 班次 : 枚举
  - 打卡上班 : 时间
  - 打卡下班 : 时间
}

class 片区 {
  - 片区ID : 字符串
  - 名称 : 字符串
}
class 门店 {
  - 门店ID : 字符串
  - 名称 : 字符串
  - 城市 : 字符串
  - 地段 : 字符串
  - 营业状态 : 枚举
}
class 房型 {
  - 房型ID : 字符串
  - 名称 : 字符串
  - 床型 : 字符串
  - 最大入住人数 : 整数
  - 房间总数 : 整数
  - 是否上架 : 布尔
}
class 房间 {
  - 房间ID : 字符串
  - 房号 : 字符串
  - 当前状态 : 枚举
  - 预计修复日期 : 日期
}

class 日价 {
  - 日期 : 日期
  - 价格 : 金额
  - 价格来源 : 枚举
}
class 价格区间 {
  - 区间ID : 字符串
  - 生效日期 : 日期
  - 下限 : 金额
  - 上限 : 金额
}
class 改价申请 {
  - 申请ID : 字符串
  - 日期 : 日期
  - 原价 : 金额
  - 申请价 : 金额
  - 申请人 : 字符串
  - 审批人 : 字符串
  - 状态 : 枚举
}

class 日库存 {
  - 日期 : 日期
  - 线上可售上限 : 整数
  - 线上已售 : 整数
  - 线下保留额度 : 整数
  - 线下已售 : 整数
}

class 订单 {
  - 订单号 : 字符串
  - 状态 : 枚举
  - 房间数 : 整数
  - 总金额 : 金额
  - 请求号 : 字符串
  - 支付截止时间 : 日期时间
  - 入住日期 : 日期
  - 离店日期 : 日期
}
class 订单明细 {
  - 明细ID : 字符串
  - 日期 : 日期
  - 间数 : 整数
  - 单价快照 : 金额
  - 小计 : 金额
}
class 通知记录 {
  - 通知ID : 字符串
  - 类型 : 枚举
  - 渠道 : 枚举
  - 状态 : 枚举
  - 失败原因 : 字符串
  - 重试次数 : 整数
  - 发送时间 : 日期时间
}
class 取消申请 {
  - 申请ID : 字符串
  - 原因 : 字符串
  - 申请人 : 字符串
  - 审批人 : 字符串
  - 状态 : 枚举
  - 申请时间 : 日期时间
}
class 升级房型申请 {
  - 申请ID : 字符串
  - 差额 : 金额
  - 申请人 : 字符串
  - 审批人 : 字符串
  - 状态 : 枚举
}

class 支付单 {
  - 支付单号 : 字符串
  - 金额 : 金额
  - 支付渠道 : 枚举
  - 交易流水号 : 字符串
  - 状态 : 枚举
  - 支付时间 : 日期时间
}
class 退款单 {
  - 退款单号 : 字符串
  - 金额 : 金额
  - 退款原因 : 字符串
  - 状态 : 枚举
  - 退款时间 : 日期时间
}
class 对账记录 {
  - 对账ID : 字符串
  - 对账日期 : 日期
  - 差异类型 : 枚举
  - 差异金额 : 金额
  - 处理结果 : 枚举
  - 状态 : 枚举
}

class 占房记录 {
  - 记录ID : 字符串
  - 晚次日期 : 日期
}
class 工单 {
  - 工单ID : 字符串
  - 类型 : 枚举
  - 原因 : 字符串
  - 涉及日期 : 日期
  - 状态 : 枚举
  - 提交人 : 字符串
  - 执行人 : 字符串
}

class 评价 {
  - 评价ID : 字符串
  - 评分 : 整数
  - 内容 : 字符串
  - 提交时间 : 日期时间
}

class 审计日志 {
  - 日志ID : 字符串
  - 操作人 : 字符串
  - 操作角色 : 枚举
  - 原因 : 字符串
  - 来源IP与设备 : 字符串
  - 动作 : 字符串
  - 对象类型 : 字符串
  - 对象ID : 字符串
  - 变更前值 : 字符串
  - 变更后值 : 字符串
  - 操作时间 : 日期时间
}
class 删除数据申请 {
  - 申请ID : 字符串
  - 对象类型 : 字符串
  - 对象ID : 字符串
  - 原因 : 字符串
  - 申请人 : 字符串
  - 审批人 : 字符串
  - 状态 : 枚举
}
class 门店绩效汇总 {
  - 汇总ID : 字符串
  - 统计期间 : 字符串
  - 订单数 : 整数
  - 入住率 : 小数
  - 平均评分 : 小数
}

片区 "1" -down- "0..*" 门店
片区 "1" -down- "0..*" 用户 : 负责人
门店 "1" -down- "0..*" 用户 : 任职
门店 "1" -down- "0..*" 排班
用户 "1" -down- "0..*" 排班 : 前台
门店 "1" -down- "0..*" 房型
房型 "1" -down- "0..*" 房间
房型 "1" -down- "0..*" 日价
房型 "1" -down- "0..*" 日库存
门店 "1" -down- "0..*" 价格区间
用户 "1" -down- "0..*" 订单 : 下单
门店 "1" -down- "0..*" 订单
订单 "1" *-- "1..*" 订单明细 : 包含
房型 "1" -down- "0..*" 订单明细
订单 "1" -down- "0..*" 占房记录
房间 "1" -down- "0..*" 占房记录
订单 "1" -down- "0..*" 支付单
订单 "1" -down- "0..*" 退款单
订单 "1" -down- "0..1" 评价
订单 "1" -down- "0..*" 通知记录
房间 "0..*" -down- "0..*" 工单 : 涉及
门店 "1" -down- "0..*" 改价申请
订单 "1" -down- "0..*" 取消申请
订单 "1" -down- "0..*" 升级房型申请
片区 "1" -down- "0..*" 删除数据申请
用户 "1" -down- "0..*" 审计日志
门店 "1" -down- "0..*" 门店绩效汇总 : 半年汇总
支付单 "1" -down- "0..1" 对账记录
退款单 "0..*" -- "1" 支付单 : 原路退回
@enduml
